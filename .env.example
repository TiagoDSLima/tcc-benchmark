# Limites de recursos dos containers.
# A camada de aplicação tem o mesmo orçamento nas duas arquiteturas: 4 CPUs e 4 GB no total.
# No monólito tudo fica em um container; nos microsserviços o orçamento é dividido entre os 7 serviços.
# Os perfis em recursos/ (RECURSOS=2cpu ou RECURSOS=8cpu) mudam só as CPUs da camada de aplicação.
# Qualquer variável deste arquivo pode ser sobrescrita na linha de comando.

MONOLITO_CPUS=4
MONOLITO_MEMORIA=4096m

GATEWAY_CPUS=0.75
GATEWAY_MEMORIA=640m
AUTH_CPUS=0.5
AUTH_MEMORIA=512m
PARTICIPANTE_CPUS=0.5
PARTICIPANTE_MEMORIA=512m
PRODUTO_CPUS=0.75
PRODUTO_MEMORIA=640m
LOJA_CPUS=0.5
LOJA_MEMORIA=512m
PEDIDO_CPUS=0.5
PEDIDO_MEMORIA=640m
PAGAMENTO_CPUS=0.5
PAGAMENTO_MEMORIA=512m

# Mesma JVM e mesmas opções em todas as aplicações
JAVA_OPCOES=-XX:MaxRAMPercentage=60

# Infraestrutura: iguais nas duas arquiteturas (Kafka e Zookeeper só existem nos microsserviços)
POSTGRES_CPUS=2
POSTGRES_MEMORIA=1024m
MINIO_CPUS=0.5
MINIO_MEMORIA=512m
KAFKA_CPUS=1
KAFKA_MEMORIA=1024m
ZOOKEEPER_CPUS=0.5
ZOOKEEPER_MEMORIA=512m
MERCADOPAGO_CPUS=1
MERCADOPAGO_MEMORIA=512m

# Balanceador de carga (nginx), usado só nos testes de escalabilidade horizontal (ESCALA=1)
BALANCEADOR_CPUS=1
BALANCEADOR_MEMORIA=256m

# Gerador de carga (k6)
K6_CPUS=2
K6_MEMORIA=1024m

# Porta publicada no host (gateway ou monólito)
PORTA=18080
